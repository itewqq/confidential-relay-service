# Copy to .env and fill locally. .env is ignored by git.
# Keep production secrets out of images, metadata, docs, shell history, and commits.

# GCP deployment coordinates (non-secret).
GCP_PROJECT=your-gcp-project
GCP_REGION=us-central1
GCP_ZONE=us-central1-a
TRUSTED_RELAY_GCP_CS_AUDIENCE=trusted-relay-attested-tls
TRUSTED_RELAY_GCP_CS_IMAGE_DIGEST=sha256:replace-with-reviewed-image-digest
TRUSTED_RELAY_GCP_CS_SERVICE_ACCOUNT=trusted-relay@your-gcp-project.iam.gserviceaccount.com
TRUSTED_RELAY_GCP_CS_PROJECT_ID=your-gcp-project
TRUSTED_RELAY_GCP_CS_ZONE=us-central1-a
TRUSTED_RELAY_EXPECTED_CONFIG_HASH=replace-with-64-hex-config-hash
TRUSTED_RELAY_RELEASE_ARTIFACT_DIGEST=replace-with-64-hex-image-or-release-digest

# Relay runtime config (non-secret unless your network names are sensitive).
TRUSTED_RELAY_UPSTREAM=https://api.openai.com
TRUSTED_RELAY_ALLOWED_UPSTREAM=https://api.openai.com
TRUSTED_RELAY_SECRET_BROKER_URL=https://broker.internal:8787/v1/secret/provider
TRUSTED_RELAY_SECRET_BROKER_CA_PEM=replace-with-private-ca-pem
TRUSTED_RELAY_SECRET_NONCE=replace-with-fresh-uuid-or-random-128-bit-value

# Operator secrets. Put real values only in local .env or a secret manager.
# The broker TLS key/cert are for the broker listener, not the attested relay.
TRUSTED_RELAY_SECRET_BROKER_TLS_CERT_PEM=replace-with-broker-cert-pem
TRUSTED_RELAY_SECRET_BROKER_TLS_KEY_PEM=replace-with-broker-key-pem
TRUSTED_RELAY_PROVIDER_TOKEN=replace-with-provider-token
TRUSTED_RELAY_GATEWAY_TOKEN=replace-with-user-tunnel-token
TRUSTED_RELAY_LOCAL_TOKEN=local-compat-token-not-provider-key

# OpenAI-compatible local app settings.
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=${TRUSTED_RELAY_LOCAL_TOKEN}
